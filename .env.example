# ── Project layout ────────────────────────────────────────────────────────────
# Absolute path to the folder that contains My Enphase.xcodeproj on your Mac.
PROJECT_DIR="/Users/yourname/path/to/my-enphase"

# Basename of the .xcodeproj file and the Xcode scheme.
PROJECT_NAME="My Enphase"

# App bundle identifier (Xcode target → General → Identity → Bundle Identifier).
BUNDLE_ID="com.example.MyEnphase"

# ── build.sh ──────────────────────────────────────────────────────────────────
# Name of the iCloud Drive folder where the built .ipa is delivered.
# Create this folder in iCloud Drive first if it doesn't exist.
ICLOUD_FOLDER_NAME="My Enphase"

# 10-character Apple Team ID — leave empty unless you hit a code-signing error.
# Find it: Xcode → Settings → Accounts → select Apple ID → Team ID column.
DEVELOPMENT_TEAM=""

# ── test.sh ───────────────────────────────────────────────────────────────────
# UDID of the simulator to run tests on.
# List available simulators: xcrun simctl list devices available | grep iPhone
SIMULATOR_ID="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"

# ── record-fixtures.sh ────────────────────────────────────────────────────────
# Enphase API credentials — used to fetch fixture data directly from the API
# without needing a booted simulator. Leave blank to skip the API path.
# Find API Key, Client ID, Client Secret at: https://developer-v4.enphase.com/
# Refresh Token: copy the value you enter in the app's Settings screen.
ENPHASE_API_KEY=""
ENPHASE_CLIENT_ID=""
ENPHASE_CLIENT_SECRET=""
ENPHASE_REFRESH_TOKEN=""
